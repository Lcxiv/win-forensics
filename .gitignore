# Bundles and raw captures from real machines never enter the repository.
# Only fixtures/ holds synthetic bundles and format fixtures.
bundles/
captures/
*.etl
# The one exception: the synthetic recorder's trace in the committed fixture bundles, a few
# kilobytes of text that says it is not an event trace log (collectors/windows/tests/SyntheticBackend.ps1).
!fixtures/collector-bundles/*/raw/wpr_trace/trace.etl
*.pml
*.PML
*.dmp
*.blg
*.evtx
# Runner harness outputs and downloaded tools
out/
tools/
# Reports the front door scripts write about a real machine (remote-access/)
wf-frontdoor-report.txt
wf-frontdoor-acceptance-*.txt
# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
build/
dist/
# OS and editors
.DS_Store
Thumbs.db
# firstmate session hooks
.claude/settings.local.json
