{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lcxiv/win-forensics/schemas/verdict.schema.json",
  "title": "Verdict (verdict.json)",
  "description": "Ranked hypotheses with their evidence chain, preceded by the coverage table that says what was and was not measured. See docs/contracts/measurement-status.md section 5.",
  "x-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict_version",
    "bundle_id",
    "generated_utc",
    "outcome",
    "validation",
    "master_clock",
    "coverage",
    "playbooks_evaluated",
    "joins",
    "hypotheses",
    "unconsumed_data",
    "versions",
    "notes"
  ],
  "properties": {
    "verdict_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$",
      "description": "ISO 8601 date and time in UTC with a trailing Z; up to seven fractional digits (100 ns)."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "verdict",
        "no_verdict",
        "refused"
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_integrity",
        "evidentiary_adequacy"
      ],
      "properties": {
        "container_integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "checks"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/check"
              }
            }
          }
        },
        "evidentiary_adequacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "checks"
          ],
          "properties": {
            "ok": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/check"
              }
            }
          }
        }
      }
    },
    "master_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "epoch_source",
        "epoch_qpc",
        "qpc_frequency_hz",
        "epoch_utc"
      ],
      "properties": {
        "domain": {
          "const": "etw_qpc"
        },
        "epoch_source": {
          "type": "string",
          "enum": [
            "etl_header",
            "first_calibration_pair",
            "none"
          ]
        },
        "epoch_qpc": {
          "type": [
            "integer",
            "null"
          ]
        },
        "qpc_frequency_hz": {
          "type": [
            "integer",
            "null"
          ]
        },
        "epoch_utc": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collectors",
        "analyzers"
      ],
      "properties": {
        "collectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "collector_id",
              "kind",
              "role",
              "measurement_status",
              "status_reason",
              "preflight",
              "applicability",
              "requested_settings",
              "enabled_settings",
              "settings_match",
              "filter_hash",
              "config_hash",
              "target_process",
              "raw_time_range",
              "decoded_time_range",
              "row_counts",
              "events_lost",
              "truncation",
              "stack_resolution_rate",
              "clock_fit",
              "versions",
              "unconsumed"
            ],
            "properties": {
              "collector_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "kind": {
                "$ref": "common.schema.json#/$defs/collector_kind"
              },
              "role": {
                "const": "collector"
              },
              "measurement_status": {
                "$ref": "common.schema.json#/$defs/measurement_status"
              },
              "status_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "preflight": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "ok",
                  "checks"
                ],
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "$ref": "common.schema.json#/$defs/check"
                    }
                  }
                }
              },
              "applicability": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "applicable",
                  "reason"
                ],
                "properties": {
                  "applicable": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "requested_settings": {
                "type": "object"
              },
              "enabled_settings": {
                "type": "object"
              },
              "settings_match": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "filter_hash": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "common.schema.json#/$defs/hash"
                  }
                ]
              },
              "config_hash": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "common.schema.json#/$defs/hash"
                  }
                ]
              },
              "target_process": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "name",
                  "pid",
                  "alive_at_start",
                  "alive_at_stop",
                  "start_utc",
                  "exit_utc"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "pid": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "alive_at_start": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "alive_at_stop": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "start_utc": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
                  },
                  "exit_utc": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
                  }
                }
              },
              "raw_time_range": {
                "$ref": "common.schema.json#/$defs/native_time_range"
              },
              "decoded_time_range": {
                "$ref": "common.schema.json#/$defs/native_time_range"
              },
              "row_counts": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/row_count_stage"
                }
              },
              "events_lost": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "truncation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "truncated",
                  "detail"
                ],
                "properties": {
                  "truncated": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "detail": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "stack_resolution_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "clock_fit": {
                "$ref": "common.schema.json#/$defs/clock_fit"
              },
              "versions": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tool_version",
                  "decoder",
                  "decoder_version",
                  "schema_version"
                ],
                "properties": {
                  "tool_version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "decoder": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "decoder_version": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                      }
                    ]
                  },
                  "schema_version": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                      }
                    ]
                  }
                }
              },
              "unconsumed": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "what",
                    "reason"
                  ],
                  "properties": {
                    "what": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "analyzers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "analyzer_id",
              "role",
              "version",
              "measurement_status",
              "status_reason",
              "inputs",
              "rows_out",
              "playbooks",
              "disconfirmers_checked",
              "joins",
              "unconsumed"
            ],
            "properties": {
              "analyzer_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "role": {
                "const": "analyzer"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "measurement_status": {
                "$ref": "common.schema.json#/$defs/measurement_status"
              },
              "status_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "decoded_table",
                    "schema_version",
                    "rows_in",
                    "collector_id"
                  ],
                  "properties": {
                    "decoded_table": {
                      "$ref": "common.schema.json#/$defs/decoded_table"
                    },
                    "schema_version": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                    },
                    "rows_in": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "collector_id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  }
                }
              },
              "rows_out": {
                "type": "integer",
                "minimum": 0
              },
              "playbooks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "disconfirmers_checked": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/disconfirmer_result"
                }
              },
              "joins": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "description": "Ids of entries in the verdict's joins list that this analyzer relied on."
              },
              "unconsumed": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "what",
                    "reason"
                  ],
                  "properties": {
                    "what": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "playbooks_evaluated": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "status",
          "disconfirmers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "evaluated",
              "not_evaluated",
              "refused"
            ]
          },
          "disconfirmers": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/disconfirmer_result"
            }
          }
        }
      }
    },
    "joins": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/join"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "playbook",
          "subsystem",
          "symptom_subsystem",
          "claim",
          "confidence",
          "window",
          "evidence",
          "disconfirmer"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "playbook": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "subsystem": {
            "$ref": "common.schema.json#/$defs/subsystem"
          },
          "symptom_subsystem": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.schema.json#/$defs/subsystem"
              }
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "window": {
            "$ref": "common.schema.json#/$defs/window_utc"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "disconfirmer": {
            "$ref": "common.schema.json#/$defs/disconfirmer_result"
          }
        }
      }
    },
    "unconsumed_data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "reason"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyze_package",
        "evidence_schema",
        "verdict_schema",
        "manifest_schema"
      ],
      "properties": {
        "analyze_package": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_schema": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "verdict_schema": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "manifest_schema": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "verdict"
          }
        }
      },
      "then": {
        "properties": {
          "hypotheses": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "no_verdict",
              "refused"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "hypotheses": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
