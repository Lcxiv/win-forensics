{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lcxiv/win-forensics/schemas/decoded/dpcisr_class_cpu.schema.json",
  "title": "dpcisr_class_cpu row",
  "description": "DPC or ISR time per driver class per CPU, summed from the dpcisr_module_cpu rows of the same report, with each class's share of that kind's time on that CPU. One row per (kind, driver class, cpu) for every class that has at least one module in the report, plus one row per (kind, driver class) with cpu null for all CPUs together. A class with no module has no row: absence is not observed, and its time may sit in unclassified.",
  "x-schema-version": "1.0.0",
  "x-decoded-table": "dpcisr_class_cpu",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "driver_class",
    "cpu",
    "usec",
    "kind_usec",
    "share",
    "module_count",
    "modules",
    "classification_sources",
    "class_map_version",
    "trace_span_start_us",
    "trace_span_end_us",
    "provenance"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "dpc",
        "isr"
      ]
    },
    "driver_class": {
      "type": "string",
      "enum": [
        "gpu",
        "network",
        "usb",
        "bluetooth",
        "audio",
        "storage",
        "kernel",
        "other",
        "unclassified"
      ]
    },
    "cpu": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "0-based CPU index, or null for the sum over every CPU of the section."
    },
    "usec": {
      "type": "integer",
      "minimum": 0,
      "description": "Sum of the class's module usec on that CPU (or on all CPUs)."
    },
    "kind_usec": {
      "type": "integer",
      "minimum": 0,
      "description": "Sum of every module's usec of the same kind on that CPU (or on all CPUs): the denominator of share."
    },
    "share": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "usec / kind_usec, null when kind_usec is 0."
    },
    "module_count": {
      "type": "integer",
      "minimum": 1
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The module names of the class, sorted."
    },
    "classification_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "inventory",
          "inbox-map",
          "none"
        ]
      },
      "description": "The distinct classification sources of the class's modules, sorted."
    },
    "class_map_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "trace_span_start_us": {
      "type": "integer",
      "minimum": 0
    },
    "trace_span_end_us": {
      "type": "integer",
      "minimum": 0
    },
    "provenance": {
      "allOf": [
        {
          "$ref": "provenance.schema.json"
        },
        {
          "properties": {
            "decoded_table": {
              "const": "dpcisr_class_cpu"
            },
            "schema_version": {
              "const": "1.0.0"
            }
          }
        }
      ]
    }
  }
}
