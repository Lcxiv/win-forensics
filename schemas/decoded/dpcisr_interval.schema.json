{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lcxiv/win-forensics/schemas/decoded/dpcisr_interval.schema.json",
  "title": "dpcisr_interval row",
  "description": "One row per (kind, interval, cpu) cell of the per interval usage tables in an xperf -a dpcisr report.",
  "x-schema-version": "1.0.0",
  "x-decoded-table": "dpcisr_interval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "interval_start_ms",
    "interval_end_ms",
    "cpu",
    "usec",
    "percent",
    "provenance"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "dpc",
        "isr"
      ]
    },
    "interval_start_ms": {
      "type": "integer",
      "minimum": 0
    },
    "interval_end_ms": {
      "type": "integer",
      "minimum": 0
    },
    "cpu": {
      "type": "integer",
      "minimum": 0
    },
    "usec": {
      "type": "integer",
      "minimum": 0
    },
    "percent": {
      "type": "number",
      "minimum": 0
    },
    "provenance": {
      "allOf": [
        {
          "$ref": "provenance.schema.json"
        },
        {
          "properties": {
            "decoded_table": {
              "const": "dpcisr_interval"
            },
            "schema_version": {
              "const": "1.0.0"
            }
          }
        }
      ]
    }
  }
}
