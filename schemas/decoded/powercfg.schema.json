{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lcxiv/win-forensics/schemas/decoded/powercfg.schema.json",
  "title": "powercfg row",
  "description": "One row per power scheme, alias, setting, request, or report reference from powercfg output. 1.1.0 adds the scheme and alias kinds, whether a scheme is the active one, whether a setting came from the hidden listing, how the AC and DC lines were classified, the minimum and maximum possible values, and the overlay the scheme GUID matches.",
  "x-schema-version": "1.1.0",
  "x-decoded-table": "powercfg",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "command",
    "captured_at_utc",
    "provenance"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "scheme",
        "alias",
        "setting",
        "request",
        "report"
      ]
    },
    "command": {
      "type": "string"
    },
    "captured_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$",
      "description": "ISO 8601 date and time in UTC with a trailing Z; up to seven fractional digits (100 ns)."
    },
    "scheme_guid": {
      "type": [
        "string",
        "null"
      ]
    },
    "scheme_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "subgroup_guid": {
      "type": [
        "string",
        "null"
      ]
    },
    "subgroup_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "setting_guid": {
      "type": [
        "string",
        "null"
      ]
    },
    "setting_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "ac_value_hex": {
      "type": [
        "string",
        "null"
      ]
    },
    "dc_value_hex": {
      "type": [
        "string",
        "null"
      ]
    },
    "possible_values": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "display",
        "system",
        "awaymode",
        "execution",
        "perfboost",
        "activelockscreen",
        null
      ]
    },
    "requester": {
      "type": [
        "string",
        "null"
      ]
    },
    "requester_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "report_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "allOf": [
        {
          "$ref": "provenance.schema.json"
        },
        {
          "properties": {
            "decoded_table": {
              "const": "powercfg"
            },
            "schema_version": {
              "const": "1.1.0"
            }
          }
        }
      ]
    },
    "is_active": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "scheme rows: true when the listing marks the scheme active or the row comes from /getactivescheme; null when the listing does not say."
    },
    "alias": {
      "type": [
        "string",
        "null"
      ],
      "description": "The powercfg alias of the scheme, subgroup or setting (SUB_PROCESSOR, PROCTHROTTLEMIN, ...), from the GUID Alias line or the /aliases listing."
    },
    "hidden": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "setting rows: true when the setting appears in the /qh listing and not in the /query listing; false when it appears in /query; null when /qh was not read."
    },
    "classified_by": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "label",
        "value",
        null
      ],
      "description": "How the AC and DC index lines were told apart: by their English label, or by the shape and order of the two hex lines (AC first, DC second, as powercfg prints them) when the labels are in another language."
    },
    "min_value_hex": {
      "type": [
        "string",
        "null"
      ]
    },
    "max_value_hex": {
      "type": [
        "string",
        "null"
      ]
    },
    "overlay": {
      "type": [
        "string",
        "null"
      ],
      "description": "scheme rows: the documented power mode overlay the GUID matches (better_battery, better_performance, best_performance), else null."
    },
    "source_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
