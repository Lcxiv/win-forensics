<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="win-forensics" Comments="dpcisr-trace 1.1.0: kernel DPC and interrupt events with the image load events needed to attribute them to a module; the CPU comes from each event itself. No process, thread or scheduling events, no stacks.">
  <Profiles>
    <SystemCollector Id="WfDpcIsrSystemCollector" Name="NT Kernel Logger">
      <BufferSize Value="1024"/>
      <Buffers Value="64"/>
    </SystemCollector>
    <SystemProvider Id="WfDpcIsrSystemProvider">
      <Keywords>
        <Keyword Value="Interrupt"/>
        <Keyword Value="DPC"/>
        <Keyword Value="Loader"/>
      </Keywords>
    </SystemProvider>
    <Profile Id="WfDpcIsrTrace.Verbose.File" Name="WfDpcIsrTrace" DetailLevel="Verbose" LoggingMode="File" Description="win-forensics dpcisr-trace: DPC, interrupt and image load events, per CPU, without stacks">
      <Collectors>
        <SystemCollectorId Value="WfDpcIsrSystemCollector">
          <SystemProviderId Value="WfDpcIsrSystemProvider"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
    <Profile Id="WfDpcIsrTrace.Verbose.Memory" Name="WfDpcIsrTrace" DetailLevel="Verbose" LoggingMode="Memory" Description="win-forensics dpcisr-trace: DPC, interrupt and image load events, per CPU, without stacks">
      <Collectors>
        <SystemCollectorId Value="WfDpcIsrSystemCollector">
          <SystemProviderId Value="WfDpcIsrSystemProvider"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
